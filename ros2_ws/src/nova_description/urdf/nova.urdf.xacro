<?xml version="1.0"?>
<!-- ============================================================
     NovaSM3 — 12-DOF quadruped (Feetech STS3215 bus servos)
     First-cut URDF. Visuals = real carved NovaSM3 STLs (exact).

     ⚠️⚠️  LINK OFFSETS + MASSES + INERTIAS BELOW ARE PLACEHOLDERS  ⚠️⚠️
     They were NOT measured from CAD (no mesh tool available when authored).
     The kinematics WILL BE WRONG until you replace every value tagged
     "TODO-CAD" with axis-to-axis distances measured from the leg_v5 assembly
     / original_body_files meshes. Do this BEFORE training any gait in MJX or
     planning with MoveIt. Mesh visuals are correct; only the numbers are not.

     Joint names are canonical here (the firmware stack is ID-based, no names).
     ID<->name map: config/joint_id_map.yaml.
     ============================================================ -->
<robot name="nova_sm3" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== STS3215 servo limits ===================== -->
  <!-- 30 kg·cm ≈ 2.94 N·m (hip), 19 kg·cm ≈ 1.86 N·m (femur/tibia).
       ~0.16 s/60° no-load ≈ 6.5 rad/s; derate. Position ranges per-joint
       are conservative placeholders — set to real mechanical travel. -->
  <xacro:property name="eff_hip"  value="2.9"/>
  <xacro:property name="eff_leg"  value="1.8"/>
  <xacro:property name="vel_servo" value="6.0"/>
  <!-- ROM = the CAD fit gates (chassis check_fit crouch sweep = authority,
       2026-07-06; replaces the TODO-CAD placeholders):
       haa: OUTBOARD 40 sw / INBOARD 15 sw (belly-pack contact from ~18
            inboard at any fold >= 30). Inboard for a RIGHT leg (y<0) =
            +roll about the +x axis; LEFT = -roll — per-side via reflect
            in leg.macro.
       hfe: toward-trunk fold +50 sw (tibia flank grazes the riser skirt
            from ~+55), BOTH ends. Away-trunk (forward protraction):
            #47 (2026-07-11, MEASURED — hardware/cad/chassis/
            head_cap_sweep.py): a FINE hfe sweep of the FRONT leg
            (femur_R+knee_arm+tibia_R+knee_bumper+shoe) vs the REAL head
            assembly (head.stl, l2_adapter.stl, head_ear.stl/_L.stl, plus
            convex hulls of the non-watertight l2_ref.stl/d456_ref.stl)
            found ZERO contact anywhere in the front leg's structurally-
            reachable hfe range (-35..-95, i.e. past leg_v6's own measured
            ~93deg self-collision mech stop) at any kfe/haa combo —
            min clearance ~34mm at today's legal haa (<=15deg), ~20mm even
            at the not-yet-unlocked 40deg outboard cap. The -50 value here
            (set 2026-07-07, the SAME day the head moved forward onto the
            front-shoulder deck — chassis/check_fit.py HEAD geometry
            comments) was never re-validated after that move: it was
            STALE, not conservative-by-design. FRONT and REAR now share
            the SAME real governing constraint instead — leg_v6/
            check_fit.py's own hip-pitch self-collision sweep (LA-19:
            clean to 92.5deg, first contact 93deg) — so hfe_ext_front ==
            hfe_ext (86deg sw, the same 7deg margin already used
            everywhere else in this file). Kept as a separate property
            (not deleted/merged into hfe_ext) so a future head-position
            change has one obvious knob to retighten.
            ⚠ SIGN MAPPING gate->URDF assumed +hfe = toward-trunk, same for
            all four legs (knees translated, one convention) — VERIFY IN SIM. -->
  <xacro:property name="haa_in"   value="0.262"/>  <!-- 15 deg inboard -->
  <xacro:property name="haa_out"  value="0.698"/>  <!-- 40 deg outboard -->
  <xacro:property name="hfe_fold" value="1.501"/>  <!-- +86 toward trunk (both) — MECHANICAL, 2026-07-25. Was +50 (riser-skirt graze); that bound is POSTURE-DEPENDENT (it is the value at full outboard splay + full knee fold only, measured +70.6 at haa 0) and a per-joint scalar cannot express it. Chassis constraint moved to nova_ops.safety_envelope.rom_envelope, enforced per posture at the choke point by safety_envelope.wrapper (every publisher) and by within_limits/solve_side (gait path). 86 = leg self-collision 93 (LA-19) minus the same 7deg margin hfe_ext uses -> symmetric window. -->
  <xacro:property name="hfe_ext"       value="1.501"/>  <!-- -86 away, REAR legs -->
  <xacro:property name="hfe_ext_front" value="1.501"/>  <!-- -86 away, FRONT legs — #47: head clearance is NOT the binding constraint (measured), leg self-collision (LA-19, 93deg) is; matches hfe_ext -->
  <xacro:property name="kfe_range" value="1.9"/>   <!-- sweep-gate: mech stop ~118 deg (tibia flank vs fork throat); 109 sw = margin. Deep-sit = v7 offset-plane option -->

  <!-- ===================== link offsets (m) ===================== -->
  <!-- MEASURED 2026-07-02 from the official Assembly_NOVA_SM3 Fusion share
       (A360 viewer instance-tree world transforms; servo-horn instances mark
       the joint axes). Numbers + method: hardware/cad/dimensions.md §6.
       Hip grid: haa axes 282.4 mm fore-aft x 78.1 mm lateral; hfe sits
       24.6 mm outboard + 9.5 mm below haa; kfe a further 9.2 mm outboard;
       the tibia S-curve puts the foot 30.5 mm outboard of kfe.
       Total haa->foot lateral = 64.3 mm = LegParams.hip_offset. -->
  <!-- HIP GRID, fixed 2026-07-27 (#165). These two were a STOCK-assembly pair:
       141.2 is the stock HFE-axis fore-aft station, and on stock that made
       hip_to_upper_x = 0 exact — the haa axis is fore-aft parallel, so sliding
       the hip origin ALONG it is a kinematic no-op, and putting the origin at
       the hfe station reproduces the geometry.
       leg_v6 broke that identity: shoulder.scad fixes the haa station at ±141.2
       (trunk end face ±63.5 + 77.7 flange) and coax.scad puts the hfe axis
       11.6 mm TOWARD THE TRUNK of it — at BOTH ends, once the rear crossmember
       is correctly yawed 180 deg (#163). Real pitch-axis spacing is 259.2, not
       282.4, so the model's stance was 23.2 mm (8.9%) longer fore-aft than the
       robot, on a platform where CoM offsets are argued at ±5 mm.
       Fixed in the form that describes the hardware literally: the haa station
       really IS ±141.2 (body_half_x unchanged) and the femur really IS 11.6 mm
       inboard of it. The alternative (body_half_x -> 0.1296) would have moved
       the hip JOINTS instead, which is a different robot — same foot-relative-
       to-hip chain, different base_link-relative stance.
       PER END, NOT PER SIDE: toward-the-trunk is -x at the front and +x at the
       rear, so leg.macro.xacro keys the sign off leg[0], the same way the hfe
       extension limit already does. A `reflect`-style per-SIDE sign would put
       both rear hips on the wrong side of their own hip station.
       Link frames do not move relative to their own parents' inertia frames, so
       compute_inertials.py output is unaffected. Mirrored in
       sim/nova_mjx/build_mjcf.py (HAA_TO_HFE[0]).
       Refs: hardware/cad/dimensions.md "Hip grid", docs/cad-review-2026-07-26.md
       §2, #163/#164. -->
  <xacro:property name="body_half_x" value="0.1412"/> <!-- MEASURED half hip-grid length (haa station, shoulder.scad) -->
  <xacro:property name="body_half_y" value="0.0390"/> <!-- MEASURED half hip-grid width  -->
  <xacro:property name="mount_z"     value="0.0380"/> <!-- hip row above chassis-mesh origin; ⚠ REVIEW-visual (trunk-node bbox polluted by children) -->
  <!-- MAGNITUDE. Sign is applied per END in leg.macro.xacro (toward trunk). -->
  <xacro:property name="hip_to_upper_x" value="0.0116"/> <!-- haa axis -> hfe axis, along the trunk axis (coax.scad HFE_Y) -->
  <!-- v6 legs (leg_v6/): femur mid-plane 33.8 from haa (coax yoke), femur/
       tibia coplanar (0), toe tab jogs 30.5 OUTBOARD (stock stance: straight
       vertical legs, feet under the leg columns, ~207mm track — right for
       quasi-static v1). Inboard jog (d=3.3, zero holding torque, 84mm track)
       evaluated + shelved until a balance controller exists. -->
  <xacro:property name="hip_to_upper_y" value="0.0338"/> <!-- haa axis -> femur mid-plane (v6) -->
  <xacro:property name="hip_to_upper_z" value="-0.0095"/><!-- MEASURED hfe drop below haa -->
  <xacro:property name="upper_to_lower_y" value="0.0"/>  <!-- v6: femur/tibia coplanar -->
  <xacro:property name="lower_to_foot_y"  value="0.0305"/><!-- toe tab jog, outboard (stock stance) -->
  <!-- MEASURED 2026-07-01 from original NovaSM3 STLs (leg_v5 keeps stock pivots).
       Femur: hfe horn axis (49.5, z10) -> kfe bore (-56.71, z22.02) in
       SM3_Frame_LeftFemur.stl = 106.9 mm axis-to-axis (the 12 mm in-plane kink
       is absorbed into hfe zero-calibration; IK uses the scalar length).
       Tibia: kfe spline (62.5, 0) -> foot post center (-66.5, 3.3) in
       SM3_Frame_RightTibia.stl = 129.0 mm (toe tip extreme = 138.0 mm).
       Method: trimesh slice-circle bore detection, hardware/cad/dimensions.md §leg. -->
  <xacro:property name="upper_to_lower_x" value="0.0"/>
  <xacro:property name="upper_to_lower_z" value="-0.1069"/><!-- MEASURED femur length -->
  <xacro:property name="lower_to_foot_x" value="0.0"/>
  <xacro:property name="lower_to_foot_z" value="-0.1290"/> <!-- MEASURED tibia length -->

  <!-- ===================== masses + inertials ===================== -->
  <!-- COMPUTED 2026-07-13 from the REAL leg_v6 meshes + embedded STS3215 servos
       (tools/compute_inertials.py): full mass / CoM / anisotropic inertia tensor
       per link, mapped into each URDF link frame (frame maps validated vs the
       URDF's own landmarks — femur STL (106.9,0,0) -> link (0,0,-0.1069)).
       Replaces the old isotropic mass*1e-3 placeholders.

       CALIBRATED 2026-07-13 from real prints: mesh volume x MEASURED effective
       density + a 60 g servo box at each pocket. 40%-infill parts (coax/femur/
       knee_arm/shoulder) = 0.712 g/cm3 (printed femur_R shell 57 g MEASURED,
       slicer 56.7 g confirmed); the tibia is 25% infill -> 0.586 g/cm3 (51 g
       slicer). ~15-30% lighter than the old 0.70 guess. Servo box + base_link
       (~2.8 kg payload, box inertia) unchanged.
       ⚠ still: Servo modeled at the shell centroid; ⚠ LEFT/RIGHT y-sign mirrored
       via `reflect` (yf=-reflect on com_y/ixy/iyz) — VERIFY IN SIM.
       Calibrated right-leg masses: hip 0.084 upper 0.122 lower 0.111 foot 0.004
       (was 0.087/0.131/0.131 at the 0.70 guess). -->
  <xacro:property name="m_base"  value="2.83"/>

  <!-- base_link: trunk envelope box inertia at m_base (payload-dominated,
       CoM at the geometric center — refine with the assembled-stack CoM). -->
  <xacro:macro name="base_inertial" params="">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m_base}"/>
      <inertia ixx="8.7e-03" iyy="2.46e-02" izz="2.65e-02"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- per-link real inertials (RIGHT-leg values; yf mirrors y-terms for LEFT) -->
  <xacro:macro name="hip_inertial" params="reflect">
    <inertial>
      <origin xyz="0.00710 ${-reflect*0.02004} 0.00497" rpy="0 0 0"/>
      <mass value="0.0836"/>
      <inertia ixx="4.099e-05" iyy="2.120e-05" izz="3.255e-05"
               ixy="${-reflect*-1.91e-06}" ixz="7.32e-07" iyz="${-reflect*3.32e-06}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="upper_inertial" params="reflect">
    <inertial>
      <origin xyz="0.00000 ${-reflect*-0.00653} -0.05067" rpy="0 0 0"/>
      <mass value="0.1219"/>
      <inertia ixx="7.486e-05" iyy="6.649e-05" izz="2.667e-05"
               ixy="${-reflect*-8.22e-10}" ixz="-3.84e-10" iyz="${-reflect*-3.51e-06}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="lower_inertial" params="reflect">
    <inertial>
      <origin xyz="-0.00054 ${-reflect*-0.01010} -0.06558" rpy="0 0 0"/>
      <mass value="0.1110"/>
      <inertia ixx="1.006e-04" iyy="9.150e-05" izz="2.321e-05"
               ixy="${-reflect*-5.64e-07}" ixz="-1.39e-06" iyz="${-reflect*-1.34e-05}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="foot_inertial" params="reflect">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0039"/>
      <inertia ixx="2.116e-07" iyy="5.602e-07" izz="5.763e-07"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:include filename="$(find nova_description)/urdf/leg.macro.xacro"/>

  <!-- ===================== base / trunk ===================== -->
  <link name="base_link">
    <visual>
      <geometry><mesh filename="package://nova_description/meshes/SM3_Frame_ChassisTrunk.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://nova_description/meshes/SM3_Frame_ChassisTrunk.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <xacro:base_inertial/>
  </link>

  <!-- ===================== 4 legs =====================
       FL=front-left  FR=front-right  RL=rear-left  RR=rear-right
       reflect +1 = left side, -1 = right side -->
  <xacro:nova_leg leg="FL" side="Left"  reflect="1"
                  mount_x="${ body_half_x}" mount_y="${ body_half_y}" mount_z="${mount_z}"/>
  <xacro:nova_leg leg="FR" side="Right" reflect="-1"
                  mount_x="${ body_half_x}" mount_y="${-body_half_y}" mount_z="${mount_z}"/>
  <xacro:nova_leg leg="RL" side="Left"  reflect="1"
                  mount_x="${-body_half_x}" mount_y="${ body_half_y}" mount_z="${mount_z}"/>
  <xacro:nova_leg leg="RR" side="Right" reflect="-1"
                  mount_x="${-body_half_x}" mount_y="${-body_half_y}" mount_z="${mount_z}"/>

</robot>
