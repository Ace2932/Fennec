<?xml version="1.0"?>
<!-- ============================================================
     NovaSM3 — 12-DOF quadruped (Feetech STS3215 bus servos)
     First-cut URDF. Visuals = real carved NovaSM3 STLs (exact).

     ⚠️⚠️  LINK OFFSETS + MASSES + INERTIAS BELOW ARE PLACEHOLDERS  ⚠️⚠️
     They were NOT measured from CAD (no mesh tool available when authored).
     The kinematics WILL BE WRONG until you replace every value tagged
     "TODO-CAD" with axis-to-axis distances measured from the leg_v5 assembly
     / original_body_files meshes. Do this BEFORE training any gait in MJX or
     planning with MoveIt. Mesh visuals are correct; only the numbers are not.

     Joint names are canonical here (the firmware stack is ID-based, no names).
     ID<->name map: config/joint_id_map.yaml.
     ============================================================ -->
<robot name="nova_sm3" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== STS3215 servo limits ===================== -->
  <!-- 30 kg·cm ≈ 2.94 N·m (hip), 19 kg·cm ≈ 1.86 N·m (femur/tibia).
       ~0.16 s/60° no-load ≈ 6.5 rad/s; derate. Position ranges per-joint
       are conservative placeholders — set to real mechanical travel. -->
  <xacro:property name="eff_hip"  value="2.9"/>
  <xacro:property name="eff_leg"  value="1.8"/>
  <xacro:property name="vel_servo" value="6.0"/>
  <xacro:property name="haa_range" value="0.7"/>   <!-- TODO-CAD mechanical travel -->
  <xacro:property name="hfe_range" value="1.5"/>   <!-- TODO-CAD -->
  <xacro:property name="kfe_range" value="2.2"/>   <!-- TODO-CAD -->

  <!-- ===================== link offsets (m) ===================== -->
  <!-- MEASURED 2026-07-02 from the official Assembly_NOVA_SM3 Fusion share
       (A360 viewer instance-tree world transforms; servo-horn instances mark
       the joint axes). Numbers + method: hardware/cad/dimensions.md §6.
       Hip grid: haa axes 282.4 mm fore-aft x 78.1 mm lateral; hfe sits
       24.6 mm outboard + 9.5 mm below haa; kfe a further 9.2 mm outboard;
       the tibia S-curve puts the foot 30.5 mm outboard of kfe.
       Total haa->foot lateral = 64.3 mm = LegParams.hip_offset. -->
  <xacro:property name="body_half_x" value="0.1412"/> <!-- MEASURED half hip-grid length -->
  <xacro:property name="body_half_y" value="0.0390"/> <!-- MEASURED half hip-grid width  -->
  <xacro:property name="mount_z"     value="0.0380"/> <!-- hip row above chassis-mesh origin; ⚠ REVIEW-visual (trunk-node bbox polluted by children) -->
  <xacro:property name="hip_to_upper_x" value="0.0"/>
  <!-- v6 legs (leg_v6/) redistribute the SAME 64.3mm total: femur mid-plane
       at 33.8 from haa (coax yoke), femur/tibia coplanar (0), foot post 30.5.
       Stock-part values were 24.6 / 9.2 / 30.5. Total unchanged -> IK d valid. -->
  <xacro:property name="hip_to_upper_y" value="0.0338"/> <!-- haa axis -> femur mid-plane (v6) -->
  <xacro:property name="hip_to_upper_z" value="-0.0095"/><!-- MEASURED hfe drop below haa -->
  <xacro:property name="upper_to_lower_y" value="0.0"/>  <!-- v6: femur/tibia coplanar -->
  <xacro:property name="lower_to_foot_y"  value="0.0305"/><!-- foot post offset (v6 = stock jog) -->
  <!-- MEASURED 2026-07-01 from original NovaSM3 STLs (leg_v5 keeps stock pivots).
       Femur: hfe horn axis (49.5, z10) -> kfe bore (-56.71, z22.02) in
       SM3_Frame_LeftFemur.stl = 106.9 mm axis-to-axis (the 12 mm in-plane kink
       is absorbed into hfe zero-calibration; IK uses the scalar length).
       Tibia: kfe spline (62.5, 0) -> foot post center (-66.5, 3.3) in
       SM3_Frame_RightTibia.stl = 129.0 mm (toe tip extreme = 138.0 mm).
       Method: trimesh slice-circle bore detection, hardware/cad/dimensions.md §leg. -->
  <xacro:property name="upper_to_lower_x" value="0.0"/>
  <xacro:property name="upper_to_lower_z" value="-0.1069"/><!-- MEASURED femur length -->
  <xacro:property name="lower_to_foot_x" value="0.0"/>
  <xacro:property name="lower_to_foot_z" value="-0.1290"/> <!-- MEASURED tibia length -->

  <!-- ===================== masses (kg) ===================== -->
  <!-- TODO-CAD: weigh / compute from CAD. STS3215 ≈ 0.06 kg each. -->
  <xacro:property name="m_base"  value="1.2"/>
  <xacro:property name="m_hip"   value="0.12"/>
  <xacro:property name="m_upper" value="0.16"/>
  <xacro:property name="m_lower" value="0.08"/>
  <xacro:property name="m_foot"  value="0.02"/>

  <!-- crude box inertia helper (TODO-CAD: replace with real tensors) -->
  <xacro:macro name="link_inertial" params="mass">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass*1e-3}" iyy="${mass*1e-3}" izz="${mass*1e-3}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:include filename="$(find nova_description)/urdf/leg.macro.xacro"/>

  <!-- ===================== base / trunk ===================== -->
  <link name="base_link">
    <visual>
      <geometry><mesh filename="package://nova_description/meshes/SM3_Frame_ChassisTrunk.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://nova_description/meshes/SM3_Frame_ChassisTrunk.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <xacro:link_inertial mass="${m_base}"/>
  </link>

  <!-- ===================== 4 legs =====================
       FL=front-left  FR=front-right  RL=rear-left  RR=rear-right
       reflect +1 = left side, -1 = right side -->
  <xacro:nova_leg leg="FL" side="Left"  reflect="1"
                  mount_x="${ body_half_x}" mount_y="${ body_half_y}" mount_z="${mount_z}"/>
  <xacro:nova_leg leg="FR" side="Right" reflect="-1"
                  mount_x="${ body_half_x}" mount_y="${-body_half_y}" mount_z="${mount_z}"/>
  <xacro:nova_leg leg="RL" side="Left"  reflect="1"
                  mount_x="${-body_half_x}" mount_y="${ body_half_y}" mount_z="${mount_z}"/>
  <xacro:nova_leg leg="RR" side="Right" reflect="-1"
                  mount_x="${-body_half_x}" mount_y="${-body_half_y}" mount_z="${mount_z}"/>

</robot>
