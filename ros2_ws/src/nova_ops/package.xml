<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nova_ops</name>
  <version>0.1.0</version>
  <description>
    NovaSM3 operations layer: preflight health checks, dashcam, safety
    envelope, bringup launcher, telemetry, status LED, battery SoC,
    bag replay. Nothing here is on the gait critical path — every node
    is allowed to crash without killing the robot.
  </description>
  <maintainer email="aidenfox2013@gmail.com">Aiden Fox</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
